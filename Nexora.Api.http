Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..tvIKDaDio-y2lVu9HyU5LXF4UWuwh1dKYF_C2Qib5kQ

{
  "pregunta": "¿Cómo funciona el sensor de detección de fatiga?",
  "respuesta": "El sensor MPU6050 monitorea el ángulo de cabeceo del conductor en tiempo real. Cuando detecta un patrón asociado a somnolencia, activa una alerta con buzzer y vibración en menos de 1 segundo, y notifica al panel de monitoreo de la flotilla.",
  "orden": 1
}

